+// 锁外 Flush：SST 写出期间（冻结层落盘中）写入、查询、统计都不被阻塞；
+// 过期等待在途 Flush 发布；发布后冻结层释放、旧 WAL 段删除；重启数据一致。
+void TestFlushOutsideLock(const std::filesystem::path& path, bool sharded) {
+    Options options;
+    options.shard_count = 2;
+    options.enable_background_compaction = false;
+    options.sharded_wal = sharded;
+    Status status;
+    auto engine = Engine::Open(path, options, &status);
+    AssertOk(status);
+    WriteTwoSeries(engine.get(), 1, 100);
+
+    std::mutex hook_mutex;
+    std::condition_variable hook_cv;
+    bool reached = false;
+    bool release = false;
+    testing::SetFaultHook([&](const char* stage) {
+        if (std::strcmp(stage, "sstable_before_rename") != 0) return;
+        std::unique_lock lock(hook_mutex);
+        reached = true;
+        hook_cv.notify_all();
+        hook_cv.wait(lock, [&] { return release; });
+    });
+    Status flush_status = Status::Error("flush not run");
+    std::thread flusher([&] { flush_status = engine->Flush(); });
+    bool flush_reached = false;
+    {
+        std::unique_lock lock(hook_mutex);
+        flush_reached = hook_cv.wait_for(lock, std::chrono::seconds(5), [&] { return reached; });
+    }
+
+    // 旧实现在 SST 写出与 fsync 期间持有全局锁，这里的写入会一直阻塞。
+    std::atomic<bool> writes_done{false};
+    std::thread writer([&] {
+        WriteTwoSeries(engine.get(), 101, 150);
+        writes_done = true;
+    });
+    const auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(5);
+    while (!writes_done.load() && std::chrono::steady_clock::now() < deadline) {
+        std::this_thread::sleep_for(std::chrono::milliseconds(1));
+    }
+    const bool writes_progressed = writes_done.load();
+    EngineStats during{};
+    bool scan_ok = false;
+    if (writes_progressed) {
+        // 查询同时读冻结层（1..100）与新的可变层（101..150）。
+        CheckTwoSeries(engine.get(), 1, 150);
+        scan_ok = true;
+        AssertOk(engine->GetStats(&during));
+    }
+    std::atomic<bool> expired{false};
+    Status expire_status = Status::Error("expire not run");
+    std::thread expirer([&] {
+        expire_status = engine->ExpireBefore(51);
+        expired = true;
+    });
+    std::this_thread::sleep_for(std::chrono::milliseconds(100));
+    const bool expire_waited = !expired.load();
+    {
+        std::lock_guard lock(hook_mutex);
+        release = true;
+    }
+    hook_cv.notify_all();
+    flusher.join();
+    writer.join();
+    expirer.join();
+    testing::SetFaultHook({});
+
+    CHECK(flush_reached);
+    CHECK(writes_progressed && scan_ok);
+    CHECK(during.flush_count == 0 && during.immutable_points == 200 &&
+          during.mutable_points == 100);
+    CHECK(expire_waited);
+    AssertOk(flush_status);
+    AssertOk(expire_status);
+    EngineStats after{};
+    AssertOk(engine->GetStats(&after));
+    CHECK(after.flush_count == 1 && after.immutable_points == 0 &&
+          after.mutable_points == 100);
+    CheckTwoSeries(engine.get(), 51, 150);
+    // Manifest 发布后旧段已删：只剩冻结时打开的新段（分片模式每个目录一段）。
+    CHECK(WalSegmentCount(path) == (sharded ? options.shard_count + 1 : 1));
+    AssertOk(engine->Close());
+
+    engine = Engine::Open(path, options, &status);
+    AssertOk(status);
+    CheckTwoSeries(engine.get(), 51, 150);
+    CHECK(SstFilesOnDisk(path) == SstFilesInManifest(path));
+    WriteTwoSeries(engine.get(), 151, 160);
+    AssertOk(engine->Close());
+    engine = Engine::Open(path, options, &status);
+    AssertOk(status);
+    CheckTwoSeries(engine.get(), 51, 160);
+    AssertOk(engine->Close());
+}
+
+// 冻结后、发布前后的真实进程退出：冻结层（旧 WAL 段）与冻结后已确认的写入
+// （新 WAL 段）都必须恢复；未发布的 SST 被清理，已发布但旧段未删的重复点去重。
+void TestCrashDuringUnlockedFlush(const std::filesystem::path& root) {
+    const char* stages[] = {"sstable_before_rename", "sstable_after_rename",
+                            "flush_after_manifest"};
+    size_t case_index = 0;
+    for (const bool sharded : {false, true}) {
+        for (const char* stage : stages) {
+            const auto path = root / ("case-" + std::to_string(case_index++));
+            Options options;
+            options.shard_count = 2;
+            options.enable_background_compaction = false;
+            options.sharded_wal = sharded;
+            const pid_t pid = fork();
+            CHECK(pid >= 0);
+            if (pid == 0) {
+                Status status;
+                auto engine = Engine::Open(path, options, &status);
+                if (!status.ok) _exit(2);
+                // 先发布一次 Manifest，使崩溃发生在「已有 Manifest」的常态库上。
+                WriteTwoSeries(engine.get(), 1, 20);
+                if (!engine->Flush().ok) _exit(3);
+                WriteTwoSeries(engine.get(), 21, 100);
+                std::mutex hook_mutex;
+                std::condition_variable hook_cv;
+                bool reached = false;
+                bool second_batch_acked = false;
+                const std::string target = stage;
+                testing::SetFaultHook([&](const char* current) {
+                    const std::string name = current;
+                    if (name == "sstable_before_rename") {
+                        std::unique_lock lock(hook_mutex);
+                        reached = true;
+                        hook_cv.notify_all();
+                        // 有界等待：旧实现持锁时写入无法推进，最终丢失第二批。
+                        hook_cv.wait_for(lock, std::chrono::seconds(3),
+                                         [&] { return second_batch_acked; });
+                    }
+                    if (name == target) _exit(0);
+                });
+                std::thread flusher([&] { (void)engine->Flush(); });
+                {
+                    std::unique_lock lock(hook_mutex);
+                    hook_cv.wait(lock, [&] { return reached; });
+                }
+                WriteTwoSeries(engine.get(), 101, 150);
+                {
+                    std::lock_guard lock(hook_mutex);
+                    second_batch_acked = true;
+                }
+                hook_cv.notify_all();
+                flusher.join();
+                _exit(5);  // 目标阶段未命中
+            }
+            int child_status = 0;
+            CHECK(waitpid(pid, &child_status, 0) == pid);
+            CHECK(WIFEXITED(child_status) && WEXITSTATUS(child_status) == 0);
+            Status status;
+            auto engine = Engine::Open(path, options, &status);
+            AssertOk(status);
+            CHECK(SstFilesOnDisk(path) == SstFilesInManifest(path));
+            CheckTwoSeries(engine.get(), 1, 150);
+            WriteTwoSeries(engine.get(), 151, 160);
+            AssertOk(engine->Flush());
+            AssertOk(engine->Close());
+            engine = Engine::Open(path, options, &status);
+            AssertOk(status);
+            CheckTwoSeries(engine.get(), 1, 160);
+            CHECK(SstFilesOnDisk(path) == SstFilesInManifest(path));
+            AssertOk(engine->Close());
+        }
+    }
+}
