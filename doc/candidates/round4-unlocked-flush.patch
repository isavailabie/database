+// WAL 目录下（含分片子目录）现存的段文件数。
+size_t WalSegmentCount(const std::filesystem::path& db) {
+    size_t count = 0;
+    for (const auto& entry : std::filesystem::recursive_directory_iterator(db / "wal")) {
+        if (entry.is_regular_file() && entry.path().extension() == ".log") ++count;
+    }
+    return count;
+}
+
+// 校验 series 1/2 恰为 [first, last] 的连续时间戳，值分别为 t 与 -t。
+void CheckTwoSeries(Engine* engine, int64_t first, int64_t last) {
+    std::unique_ptr<Cursor> cursor;
+    AssertOk(engine->Scan({1, 2}, 0, 1000000, &cursor));
+    const auto points = Read(cursor.get());
+    CHECK(points.size() == static_cast<size_t>(2 * (last - first + 1)));
+    size_t index = 0;
+    for (int64_t ts = first; ts <= last; ++ts) {
+        CHECK(points[index].series_id == 1 && points[index].timestamp_ms == ts &&
+              points[index].value == static_cast<double>(ts));
+        ++index;
+        CHECK(points[index].series_id == 2 && points[index].timestamp_ms == ts &&
+              points[index].value == -static_cast<double>(ts));
+        ++index;
+    }
+}
+
+void WriteTwoSeries(Engine* engine, int64_t first, int64_t last) {
+    for (int64_t ts = first; ts <= last; ++ts) {
+        AssertOk(engine->WriteBatch(
+            {{1, ts, static_cast<double>(ts)}, {2, ts, -static_cast<double>(ts)}}));
+    }
+}
